# Copy to .env and fill in. Never commit .env.

# Claude API (https://console.anthropic.com). Tests and CI never need it.
ANTHROPIC_API_KEY=

# Models: fast for tool-heavy agents and the judge, strong for the analyst and escalation
MODEL_FAST=claude-haiku-5-5
MODEL_STRONG=claude-opus-5-5

# Spend caps in USD: one user query, and the calendar month
LLM_MAX_USD_PER_QUERY=0.50
LLM_MONTHLY_BUDGET_USD=25

# CrewAI's anonymous telemetry stays off
CREWAI_DISABLE_TELEMETRY=true

STATE_DB=var/safeflight.db
REDIS_URL=redis://localhost:6379/0
LOG_LEVEL=INFO
